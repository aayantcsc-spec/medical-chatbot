# HealthBot Research - backend configuration. Copy to backend/.env and adjust.
# Never commit a real .env.

# ---- Core -------------------------------------------------------------
# Session-signing key. If empty, a random key is generated once and saved to
# backend/.flask_secret (git-ignored), so sessions survive restarts.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production
FLASK_ENV=development

# Where the React dev server runs (allowed CORS origin). In production the
# Flask app serves the built frontend itself, so CORS is not needed.
FRONTEND_URL=http://localhost:5173
# Optional comma-separated list overriding FRONTEND_URL for CORS
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when serving over HTTPS so the session cookie is Secure-only.
SESSION_COOKIE_SECURE=false
SESSION_DAYS=7

HOST=127.0.0.1
PORT=5000

# Login/register rate limit (Flask-Limiter syntax) and its storage.
AUTH_RATE_LIMIT=10 per minute; 50 per hour
RATELIMIT_STORAGE_URI=memory://

# Load models in the background at startup so the first request is fast.
WARM_UP_MODELS=true

# ---- Optional generative provider (NOT used by the current build) -------
# The six architectures and the Health Q&A bots run fully offline. These
# variables are reserved for a future optional generative step and are read
# only by legacy_app.py's old RAG module.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=false

# ---- legacy_app.py only (original Jinja UI) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
